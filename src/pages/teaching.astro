---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import GoldRule from '../components/GoldRule.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import OutlineButton from '../components/OutlineButton.astro';
import TeachingFeatureCard from '../components/TeachingFeatureCard.astro';
import StatItem from '../components/StatItem.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import LiveCasesPanel from '../components/LiveCasesPanel.astro';
import TeachingIllustration from '../components/TeachingIllustration.astro';
import { SITE, teachingStats, testimonials, taCourses } from '../data/content';
import { SITE_TITLE } from '../consts';
---

<Layout
  title={`Teaching | ${SITE_TITLE}`}
  description="Teaching by Ali Ahmadi, including COMM401 Business and Corporate Strategy and the AI case method at LiveCases.org."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <SectionEyebrow>Teaching</SectionEyebrow>
        <h1>
          Teaching with Purpose.<br />
          Learning that Sticks.
        </h1>
        <p class="lede">
          I teach strategy through engaging cases, active learning, and experiential tools that connect theory to
          real-world decisions.
        </p>
        <div class="stats">
          {teachingStats.map((stat) => <StatItem icon={stat.icon} value={stat.value} label={stat.label} />)}
        </div>
      </div>
      <div class="hero-graphic" aria-hidden="true">
        <TeachingIllustration />
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container feature-grid">
      <TeachingFeatureCard
        href="#courses"
        icon="book"
        title="My Courses"
        description="I have taught and TA'd courses in Strategy, including the COMM401-business and corporate strategy."
      />
      <TeachingFeatureCard
        href="#approach"
        icon="users"
        title="Teaching Approach"
        description="How I design learning experiences that connect theory to practice and ask students to take a position."
      />
      <TeachingFeatureCard
        href="#ai"
        icon="spark"
        title="AI in Teaching"
        description="Using AI cases, simulations, and workshops so students practice judgment rather than outsource it."
      />
      <TeachingFeatureCard
        href="#feedback"
        icon="quote"
        title="Student Feedback"
        description="What students say about the learning experience in COMM401."
      />
    </div>
  </section>

  <section class="two-col" id="courses">
    <div class="container columns">
      <div>
        <SectionEyebrow>Course Taught</SectionEyebrow>
        <h2>COMM401 Business and Corporate Strategy</h2>
        <ul class="checks">
          <li>
            <Icon name="check" size={18} />
            <span>Core strategy capstone for fourth-year Commerce students (85–86 per section; 169 taught).</span>
          </li>
          <li>
            <Icon name="check" size={18} />
            <span>Live AI cases reflecting current strategic challenges, delivered through LiveCases.org.</span>
          </li>
          <li>
            <Icon name="check" size={18} />
            <span>Capsim simulation and AI mini-activities that connect theory with decisions.</span>
          </li>
          <li>
            <Icon name="check" size={18} />
            <span>High engagement, with teaching evaluations of 6.23/7 (Fall 2024) and 6.71/7 (Fall 2025).</span>
          </li>
        </ul>
      </div>

      <div id="approach">
        <SectionEyebrow>My Teaching Philosophy</SectionEyebrow>
        <h2>Engage. Challenge. Empower.</h2>
        <p>
          I want students to see management as a system of choices, not a pile of frameworks. 
        </p>
        <p>
          In a curious classroom, the students should leave able to turn messy information into a
          recommendation, and to notice who is affected by that recommendation—including people who are not in the room.
        </p>
      </div>
    </div>
  </section>

  <section class="ai-band" id="ai">
    <div class="container ai-grid">
      <div>
        <SectionEyebrow>AI in Teaching</SectionEyebrow>
        <h2>Cases students cannot paste into a chatbot</h2>
        <p>
          In COMM401 I developed seven interactive AI cases and eight mini-activities. Students interview characters who
          each hold part of the file, then defend a recommendation. The same method is now used more widely at Smith
          through LiveCases.org.
        </p>
        <p>
          I also teach a hands-on workshop, Coding with AI, for commerce students with no programming background.
        </p>
        <a class="arrow-link" href={SITE.workshopPdfHref} download>
          Download workshop slides
          <Icon name="arrow" size={16} />
        </a>
      </div>
      <div>
        <SectionEyebrow>Also at Smith</SectionEyebrow>
        <h2>Teaching assistant</h2>
        <ul class="ta-list">
          {taCourses.map((course) => <li>{course}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="feedback" id="feedback">
    <div class="container">
      <header class="section-intro">
        <SectionEyebrow>Student Feedback</SectionEyebrow>
        <h2>What Students Say</h2>
      </header>

      <div class="carousel" data-carousel>
        <button class="carousel-btn prev" type="button" aria-label="Previous testimonials">
          <Icon name="arrow-left" size={18} />
        </button>
        <div class="carousel-window">
          <div class="carousel-track">
            {testimonials.map((item) => <TestimonialCard quote={item.quote} attribution={item.attribution} meta={item.meta} />)}
          </div>
        </div>
        <button class="carousel-btn next" type="button" aria-label="Next testimonials">
          <Icon name="arrow" size={18} />
        </button>
      </div>
      <div class="dots" data-dots aria-hidden="true"></div>
    </div>
  </section>

  <LiveCasesPanel variant="teaching" />

  <section class="closing">
    <div class="container">
      <blockquote>The best classrooms prepare students not just for exams, but for opportunities.</blockquote>
      <GoldRule />
    </div>
  </section>
</Layout>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  if (carousel) {
    const track = carousel.querySelector<HTMLElement>('.carousel-track');
    const cards = [...carousel.querySelectorAll<HTMLElement>('.testimonial-card')];
    const dotsWrap = document.querySelector<HTMLElement>('[data-dots]');
    const prev = carousel.querySelector<HTMLButtonElement>('.prev');
    const next = carousel.querySelector<HTMLButtonElement>('.next');
    let index = 0;

    const perView = () => (window.innerWidth < 768 ? 1 : window.innerWidth < 1024 ? 2 : 3);
    const maxIndex = () => Math.max(0, cards.length - perView());

    function renderDots() {
      if (!dotsWrap) return;
      const pages = maxIndex() + 1;
      dotsWrap.innerHTML = '';
      for (let i = 0; i < pages; i += 1) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = i === index ? 'dot active' : 'dot';
        dot.setAttribute('aria-label', `Go to testimonial group ${i + 1}`);
        dot.addEventListener('click', () => {
          index = i;
          update();
        });
        dotsWrap.append(dot);
      }
    }

    function update() {
      index = Math.min(index, maxIndex());
      const card = cards[0];
      const styles = track ? getComputedStyle(track) : undefined;
      const gap = styles ? parseFloat(styles.gap || '0') : 0;
      const width = card ? card.getBoundingClientRect().width : 0;
      if (track) track.style.transform = `translateX(-${index * (width + gap)}px)`;
      dotsWrap?.querySelectorAll('.dot').forEach((dot, i) => dot.classList.toggle('active', i === index));
    }

    prev?.addEventListener('click', () => {
      index = Math.max(0, index - 1);
      update();
    });
    next?.addEventListener('click', () => {
      index = Math.min(maxIndex(), index + 1);
      update();
    });
    window.addEventListener('resize', () => {
      renderDots();
      update();
    });

    renderDots();
    update();
  }
</script>

<style>
  .hero {
    padding: 1.5rem 0 3rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.95fr);
    gap: 2.25rem;
    align-items: center;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.6rem, 5vw, 3.9rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .lede {
    max-width: 36rem;
    margin: 0 0 1.75rem;
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding-top: 0.4rem;
  }

  .stats :global(.stat-item + .stat-item) {
    padding-left: 1.1rem;
    border-left: 1px solid var(--border);
  }

  .hero-graphic {
    min-height: 280px;
    overflow: visible;
  }

  .features {
    padding: 0 0 4rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.15rem;
  }

  .two-col {
    padding: 0 0 4rem;
  }

  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
  }

  .columns > div:last-child {
    padding-left: 2rem;
    border-left: 1px solid var(--border);
  }

  .columns h2 {
    margin: 0 0 1.1rem;
    font-size: 2rem;
  }

  .checks {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .checks li {
    display: flex;
    gap: 0.7rem;
    margin: 0 0 0.85rem;
    color: var(--text);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .checks :global(.icon) {
    color: var(--gold);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .philosophy-quote {
    display: flex;
    gap: 0.7rem;
    margin: 1.3rem 0 0;
    padding: 0;
    border: 0;
  }

  .philosophy-quote .quote-mark {
    color: var(--gold);
    font-family: var(--font-serif);
    font-size: 2.4rem;
    line-height: 0.8;
  }

  .philosophy-quote p {
    margin: 0;
    color: var(--navy);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-style: italic;
  }

  .ai-band {
    padding: 3rem 0;
    background: var(--bg-subtle);
  }

  .ai-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
  }

  .ai-grid h2 {
    margin: 0 0 0.8rem;
    font-size: 1.85rem;
  }

  .ta-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ta-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }

  .feedback {
    padding: 4.5rem 0 3rem;
  }

  .section-intro {
    text-align: center;
    margin-bottom: 2rem;
  }

  .section-intro h2 {
    margin: 0;
    font-size: 2.3rem;
  }

  .carousel {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.75rem;
    align-items: stretch;
  }

  .carousel-window {
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    gap: 1.1rem;
    transition: transform 200ms ease;
  }

  .carousel-track :global(.testimonial-card) {
    flex: 0 0 calc((100% - 2.2rem) / 3);
  }

  .carousel-btn {
    align-self: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    background: transparent;
    color: var(--gold);
    cursor: pointer;
  }

  .dots {
    display: flex;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 1.25rem;
  }

  .dots :global(.dot) {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--border-strong);
    cursor: pointer;
  }

  .dots :global(.dot.active) {
    background: var(--gold);
  }

  .closing {
    padding: 0 0 4.5rem;
    text-align: center;
  }

  .closing blockquote {
    max-width: 36rem;
    margin: 0 auto 1rem;
    color: var(--navy);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-style: italic;
  }

  .closing :global(.gold-rule) {
    margin-inline: auto;
  }

  @media (max-width: 1024px) {
    .feature-grid {
      grid-template-columns: 1fr 1fr;
    }

    .carousel-track :global(.testimonial-card) {
      flex-basis: calc((100% - 1.1rem) / 2);
    }
  }

  @media (max-width: 900px) {
    .hero-grid,
    .columns,
    .ai-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .hero-graphic {
      max-width: 22rem;
      min-height: 0;
      justify-self: start;
    }

    .columns > div:last-child {
      padding-left: 0;
      border-left: 0;
    }

    .stats {
      grid-template-columns: 1fr;
    }

    .stats :global(.stat-item + .stat-item) {
      padding-left: 0;
      border-left: 0;
      padding-top: 0.75rem;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 768px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .carousel {
      grid-template-columns: auto 1fr auto;
    }

    .carousel-track :global(.testimonial-card) {
      flex-basis: 100%;
    }

    h1 {
      font-size: 2.45rem;
    }

    h1 br {
      display: none;
    }
  }
</style>
