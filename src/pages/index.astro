---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import GoldRule from '../components/GoldRule.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import ResearchCard from '../components/ResearchCard.astro';
import LiveCasesPanel from '../components/LiveCasesPanel.astro';
import { SITE, homeResearchCards } from '../data/content';
import { SITE_TITLE } from '../consts';
---

<Layout title={SITE_TITLE} description={SITE.description}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Ali Ahmadi</h1>
        <p class="role">{SITE.role}</p>
        <p class="affiliation">{SITE.affiliation}</p>
        <GoldRule />
        <p class="identity">
          <span class="identity-icon"><Icon name="leaf" size={18} /></span>
          <em>{SITE.identityLine}</em>
        </p>
        <p class="bio">
          I study how competitive surprises shape rivalry and performance. I extract insights from unstructured text using natural language processing and large language models to understand competitive interactions.
        </p>
        <PrimaryButton href="/research">
          View Research
          <Icon name="arrow" size={16} slot="icon" />
        </PrimaryButton>
      </div>

      <div class="hero-portrait">
        <div class="portrait-frame">
          <img
            src="/images/ali-headshot.jpg"
            alt="Ali Ahmadi"
            width="768"
            height="768"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="research-section">
    <div class="container">
      <header class="section-intro">
        <SectionEyebrow>Research</SectionEyebrow>
        <h2>Understanding Strategy in Competitive Environments</h2>
        <GoldRule />
      </header>
      <div class="research-grid">
        {
          homeResearchCards.map((card) => (
            <ResearchCard
              href={`/research#${card.id}`}
              title={card.title}
              description={card.description}
              illustration={card.illustration}
              icon={card.icon}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="lower-row">
    <div class="container split">
      <article class="teaching-panel surface-card">
        <SectionEyebrow>Teaching</SectionEyebrow>
        <h2>COMM401 Business and Corporate Strategy</h2>
        <div class="teaching-body">
          <div class="navy-icon" aria-hidden="true">
            <Icon name="classroom" size={28} />
          </div>
          <ul>
            <li>
              <Icon name="check" size={16} />
              <span>AI-powered simulations that connect theory to decisions</span>
            </li>
            <li>
              <Icon name="check" size={16} />
              <span>Live cases based on contemporary strategic challenges</span>
            </li>
            <li>
              <Icon name="check" size={16} />
              <span>High engagement, with a most recent evaluation of 6.71/7</span>
            </li>
          </ul>
        </div>
        <a class="arrow-link" href="/teaching">
          Learn More About Teaching
          <Icon name="arrow" size={16} />
        </a>
      </article>

      <LiveCasesPanel variant="home" />
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 2.25rem 0 4.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
    gap: 4.5rem;
    align-items: center;
  }

  h1 {
    margin: 0 0 0.55rem;
    font-size: clamp(3.4rem, 6vw, 4.6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .role {
    margin: 0 0 0.2rem;
    color: var(--gold);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .affiliation {
    margin: 0 0 1.15rem;
    color: var(--navy);
    font-family: var(--font-serif);
    font-size: 1.35rem;
  }

  .identity {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin: 1.1rem 0 1.25rem;
    color: var(--navy);
    font-family: var(--font-serif);
    font-size: 1.12rem;
    line-height: 1.45;
  }

  .identity-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    margin-top: 0.1rem;
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--gold);
  }

  .bio {
    max-width: 36rem;
    margin: 0 0 1.6rem;
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .hero-portrait {
    display: flex;
    justify-content: flex-end;
  }

  .portrait-frame {
    position: relative;
    width: min(100%, 26rem);
  }

  .portrait-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    object-position: center;
    border-radius: 12px;
  }

  .portrait-affiliation {
    position: absolute;
    left: 0;
    bottom: 1.1rem;
    margin: 0;
    padding: 0.45rem 0.8rem;
    background: rgba(252, 251, 248, 0.92);
    color: var(--navy);
    font-family: var(--font-serif);
    font-size: 1rem;
    letter-spacing: 0.01em;
  }

  .research-section {
    padding: 1rem 0 4.5rem;
  }

  .section-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-intro h2 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 3.4vw, 2.5rem);
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.35rem;
  }

  .lower-row {
    padding: 0 0 4.5rem;
  }

  .split {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 1.35rem;
  }

  .teaching-panel {
    padding: 1.7rem 1.6rem 1.5rem;
  }

  .teaching-panel h2 {
    margin: 0 0 1.2rem;
    font-size: 1.7rem;
  }

  .teaching-body {
    display: flex;
    gap: 1.2rem;
    margin-bottom: 1.3rem;
  }

  .navy-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    background: var(--navy);
    color: var(--gold);
    border-radius: 6px;
  }

  .teaching-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .teaching-panel li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0 0 0.55rem;
    color: var(--text);
    font-size: 0.95rem;
  }

  .teaching-panel li :global(.icon) {
    color: var(--gold);
    margin-top: 0.15rem;
  }

  @media (max-width: 1024px) {
    .hero-grid,
    .split,
    .research-grid {
      gap: 1.25rem;
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 1.25rem;
    }

    .hero-grid,
    .split,
    .research-grid {
      grid-template-columns: 1fr;
    }

    .hero-portrait {
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 3rem;
    }

    .teaching-body {
      flex-direction: column;
    }
  }
</style>
