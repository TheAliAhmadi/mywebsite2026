---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { SITE, SOCIAL_LINKS } from '../data/content';
import { SITE_TITLE } from '../consts';
---

<Layout
  title={`Contact | ${SITE_TITLE}`}
  description="Get in touch with Ali Ahmadi - PhD Candidate at Smith School of Business, Queen’s University."
>
  <section class="page-hero">
    <div class="container">
      <h1>Contact</h1>
      <p>Research conversations, teaching, and collaborations are welcome.</p>
    </div>
  </section>

  <section class="contact">
    <div class="container grid">
      <div>
        <h2>Reach me</h2>
        <a class="info" href={`mailto:${SITE.email}`}>
          <span class="icon-wrap"><Icon name="mail" size={20} /></span>
          <span>
            <strong>Email</strong>
            {SITE.email}
          </span>
        </a>
        <div class="info">
          <span class="icon-wrap"><Icon name="pin" size={20} /></span>
          <span>
            <strong>Office</strong>
            {SITE.location}
          </span>
        </div>
        <div class="social">
          <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={SOCIAL_LINKS.x} target="_blank" rel="noopener noreferrer">X</a>
          <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        </div>
      </div>

      <form class="surface-card" action="https://formspree.io/f/xnjqrenn" method="POST">
        <h2>Send a message</h2>
        <label>
          Name
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>
          Email
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label>
          Subject
          <input type="text" name="subject" required />
        </label>
        <label>
          Message
          <textarea name="message" rows="6" required></textarea>
        </label>
        <button class="btn-primary" type="submit">Send Message</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 2.5rem 0 1rem;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2.8rem, 5vw, 3.8rem);
  }

  .page-hero p {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .contact {
    padding: 1.5rem 0 4.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3rem;
    align-items: start;
  }

  h2 {
    margin: 0 0 1.1rem;
    font-size: 1.8rem;
  }

  .info {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    margin-bottom: 1rem;
    padding: 1rem 1.1rem;
    color: inherit;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .info strong {
    display: block;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .icon-wrap {
    color: var(--gold);
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .social a:hover {
    color: var(--gold-deep);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.6rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--navy);
    font-size: 0.9rem;
    font-weight: 600;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    font-family: inherit;
    font-size: 1rem;
    font-weight: 400;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
    background: var(--white);
  }

  .btn-primary {
    align-self: flex-start;
    margin-top: 0.4rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
