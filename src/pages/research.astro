---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import OutlineButton from '../components/OutlineButton.astro';
import ResearchIllustration from '../components/ResearchIllustration.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { SITE, RESEARCH_FILTERS, researchItems, type ResearchCategory } from '../data/content';
import { SITE_TITLE } from '../consts';

const categorySections = RESEARCH_FILTERS.filter((filter) => filter.id !== 'all').map((filter) => {
  const id = filter.id as ResearchCategory;
  return {
    id,
    label: filter.label,
    featured: id === 'dissertation' || id === 'published',
    items: researchItems
      .filter((item) => item.categories.includes(id))
      .sort((a, b) => (a.rank[id] ?? 99) - (b.rank[id] ?? 99)),
  };
});

const otherPublications = researchItems.filter((item) => item.categories.length === 0);
---

<Layout
  title={`Research | ${SITE_TITLE}`}
  description="Research by Ali Ahmadi on competitive surprise, positioning threats, and competitive dynamics."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1>Research</h1>
        <p class="subtitle">Understanding strategy in competitive environments</p>
        <p>
          In my dissertation, I ask how competitive surprise—a firm-initiated competitive event that is unexpected to rivals and other market participants—shapes the rival's response time and effectiveness.
        </p>
        <p>
          Empirically, I use large-scale text mining and large language models on news articles, SEC filings, and other unstructured text
          to measure and examine these questions.
        </p>
        <OutlineButton href={SITE.cvHref} external>
          View CV
          <Icon name="arrow" size={16} slot="icon" />
        </OutlineButton>
      </div>
      <div class="hero-graphic" aria-hidden="true">
        <ResearchIllustration kind="hero" />
      </div>
    </div>
  </section>

  <section class="methods">
    <div class="container methods-grid">
      <article>
        <Icon name="book" size={22} />
        <h2>Theory + Data</h2>
        <p>I develop theory and test it with large-scale data, event studies, and field evidence.</p>
      </article>
      <article>
        <Icon name="code" size={22} />
        <h2>Computational Methods</h2>
        <p>I build NLP and LLM pipelines to capture strategic phenomena in news, filings, and action streams.</p>
      </article>
      <article>
        <Icon name="chart" size={22} />
        <h2>Strategic Focus</h2>
        <p>I study competitive dynamics, information, and firm behavior in real product and geographic markets.</p>
      </article>
      <article>
        <Icon name="impact" size={22} />
        <h2>Impact</h2>
        <p>The aim is scholarship that also helps managers see rivalry, surprise, and positioning more clearly.</p>
      </article>
    </div>
  </section>

  <section class="projects">
    <div class="container">
      <div class="filter-row">
        <nav class="filters" aria-label="Research categories">
          {
            RESEARCH_FILTERS.map((filter, index) => (
              <button type="button" class:list={[{ active: index === 0 }]} data-filter={filter.id}>
                {filter.label}
              </button>
            ))
          }
        </nav>
      </div>

      {
        categorySections.map((section) => (
          <section class="category-section" data-category-section={section.id} aria-label={section.label}>
            <SectionEyebrow>{section.label}</SectionEyebrow>
            <div class:list={['category-list', { 'surface-card compact-list': !section.featured }]}>
              {section.items.map((item) => (
                <ProjectRow
                  item={item}
                  compact={!section.featured}
                  anchor={section.id === 'dissertation' || section.id === 'published'}
                  showPresentationNote={section.id === 'presentation'}
                />
              ))}
            </div>
          </section>
        ))
      }

      {
        otherPublications.length > 0 && (
          <section class="category-section" data-category-section="other" aria-label="Book chapters">
            <SectionEyebrow>Book chapters</SectionEyebrow>
            <div class="category-list surface-card compact-list">
              {otherPublications.map((item) => (
                <ProjectRow item={item} compact />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </section>

  <section class="approach">
    <div class="container approach-panel">
      <div>
        <h2>Research Approach</h2>
        <p>
          I care about phenomena that are hard to see until they are measured. That means building datasets from
          unstructured text, pairing them with theory, and asking what the resulting patterns imply for rivalry and
          managerial choice.
        </p>
      </div>
      <OutlineButton href="/contact">
        Learn More About My Work
        <Icon name="arrow" size={16} slot="icon" />
      </OutlineButton>
    </div>
  </section>
</Layout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-category-section]')];

  function apply(filter: string) {
    buttons.forEach((button) => button.classList.toggle('active', button.dataset.filter === filter));
    sections.forEach((section) => {
      const category = section.dataset.categorySection;
      section.hidden = filter !== 'all' && category !== filter;
    });
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
  });

  apply('all');
</script>

<style>
  .hero {
    padding: 1.5rem 0 2.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 2rem;
    align-items: center;
  }

  h1 {
    margin: 0 0 0.45rem;
    font-size: clamp(3.4rem, 6vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .subtitle {
    margin: 0 0 1.2rem;
    color: var(--gold);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .hero p {
    max-width: 38rem;
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .hero p.subtitle {
    color: var(--gold);
    max-width: none;
  }

  .hero .btn-outline {
    margin-top: 0.5rem;
  }

  .hero-graphic {
    min-height: 280px;
  }

  .methods {
    padding: 2.25rem 0;
    background: var(--bg-subtle);
  }

  .methods-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
  }

  .methods article :global(.icon) {
    color: var(--gold);
    margin-bottom: 0.7rem;
  }

  .methods h2 {
    margin: 0 0 0.4rem;
    font-size: 1.25rem;
  }

  .methods p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .projects {
    padding: 3.25rem 0 2rem;
  }

  .filter-row {
    display: flex;
    align-items: center;
    margin-bottom: 2.25rem;
    border-bottom: 1px solid var(--border);
  }

  .filters {
    display: flex;
    gap: 1.4rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filters button {
    flex: 0 0 auto;
    padding: 0.65rem 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    cursor: pointer;
    transition: color var(--ease);
  }

  .filters button:hover,
  .filters button.active {
    color: var(--navy);
  }

  .filters button.active {
    border-bottom-color: var(--gold);
  }

  .category-section {
    margin-bottom: 2.75rem;
  }

  .compact-list {
    overflow: hidden;
  }

  .approach {
    padding: 1rem 0 4.5rem;
  }

  .approach-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 2.1rem;
    background: var(--bg-subtle);
    border-radius: var(--radius-lg);
  }

  .approach h2 {
    margin: 0 0 0.55rem;
    font-size: 1.85rem;
  }

  .approach p {
    margin: 0;
    max-width: 40rem;
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .methods-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .hero-grid,
    .approach-panel {
      grid-template-columns: 1fr;
      display: grid;
    }

    .hero-graphic {
      max-width: 320px;
      min-height: 0;
      justify-self: start;
    }

    .filter-row {
      flex-direction: column;
      align-items: stretch;
      padding-bottom: 0.6rem;
    }
  }

  @media (max-width: 640px) {
    .methods-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: 3rem;
    }
  }
</style>
