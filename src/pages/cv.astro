---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import { SITE } from '../data/content';
import { SITE_TITLE } from '../consts';
---

<Layout
  title={`CV | ${SITE_TITLE}`}
  description="Curriculum Vitae of Ali Ahmadi - PhD Candidate in Management (Strategy) at Smith School of Business, Queen’s University."
>
  <section class="page-hero">
    <div class="container">
      <h1>Curriculum Vitae</h1>
      <p>Download the full CV or read it below.</p>
      <PrimaryButton href={SITE.cvHref} external>
        Download CV (PDF)
        <Icon name="arrow" size={16} slot="icon" />
      </PrimaryButton>
    </div>
  </section>

  <section class="viewer">
    <div class="container">
      <div class="pdf-frame">
        <iframe src={SITE.cvHref} title="Ali Ahmadi CV" loading="lazy"></iframe>
      </div>
      <p class="fallback">
        Can’t see the PDF? <a href={SITE.cvHref} download>Download it directly</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 2.5rem 0 2rem;
    text-align: center;
  }

  h1 {
    margin: 0 0 0.6rem;
    font-size: clamp(2.8rem, 5vw, 3.6rem);
  }

  p {
    margin: 0 0 1.25rem;
    color: var(--text-muted);
  }

  .viewer {
    padding: 0 0 4rem;
  }

  .pdf-frame {
    overflow: hidden;
    height: 85vh;
    min-height: 640px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .fallback {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.92rem;
  }

  .fallback a {
    color: var(--gold-deep);
  }
</style>
