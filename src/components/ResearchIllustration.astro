---
interface Props {
  kind: 'surprise' | 'positioning' | 'dynamics' | 'hero';
  class?: string;
}

const { kind, class: className } = Astro.props;
---

{
  kind === 'surprise' && (
    <svg class:list={['research-illustration', className]} viewBox="0 0 400 168" fill="none" aria-hidden="true">
      <rect width="400" height="168" fill="#F7F5EF" />
      <g stroke="#071F46" stroke-width="1" stroke-linecap="round" opacity="0.22">
        <path d="M-10 28 C 40 18, 90 38, 140 28 S 240 18, 290 30 S 390 22, 430 32" stroke-dasharray="1.4 5.5" />
        <path d="M-10 44 C 50 32, 100 54, 150 44 S 250 34, 300 46 S 390 38, 430 48" stroke-dasharray="1.4 5.5" />
        <path d="M-10 60 C 45 50, 95 72, 150 60 S 245 50, 300 64 S 390 54, 430 64" stroke-dasharray="1.4 5.5" />
        <path d="M-10 76 C 40 66, 100 88, 155 76 S 250 66, 305 80 S 390 70, 430 80" stroke-dasharray="1.4 5.5" />
        <path d="M-10 92 C 55 80, 105 104, 160 92 S 255 82, 310 96 S 390 86, 430 96" stroke-dasharray="1.4 5.5" />
        <path d="M-10 108 C 50 98, 110 120, 165 108 S 260 98, 315 112 S 390 102, 430 112" stroke-dasharray="1.4 5.5" />
        <path d="M-10 124 C 45 114, 100 136, 155 124 S 250 114, 305 128 S 390 118, 430 128" stroke-dasharray="1.4 5.5" />
        <path d="M-10 140 C 55 128, 110 150, 165 140 S 255 130, 310 144 S 390 134, 430 144" stroke-dasharray="1.4 5.5" />
      </g>
      <path
        d="M-10 86 C 70 54, 130 118, 200 82 S 310 48, 430 78"
        stroke="#C58B2A"
        stroke-width="1.35"
        fill="none"
        stroke-linecap="round"
        opacity="0.9"
      />
      <circle r="3.2" fill="#C58B2A">
        <animateMotion dur="12s" repeatCount="indefinite" path="M-10 86 C 70 54, 130 118, 200 82 S 310 48, 430 78" />
      </circle>
    </svg>
  )
}

{
  kind === 'positioning' && (
    <svg class:list={['research-illustration', className]} viewBox="0 0 400 168" fill="none" aria-hidden="true">
      <rect width="400" height="168" fill="#F7F5EF" />
      <g transform="translate(96 86)">
        <circle r="62" stroke="#C58B2A" stroke-opacity="0.32" />
        <circle r="46" stroke="#071F46" stroke-opacity="0.14" />
        <circle r="30" stroke="#C58B2A" stroke-opacity="0.28" />
        <circle r="16" stroke="#071F46" stroke-opacity="0.22" />
        <circle r="3.5" fill="#071F46" />
        <g>
          <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="16s" repeatCount="indefinite" />
          <circle cx="0" cy="-16" r="2.1" fill="#071F46" fill-opacity="0.4" />
        </g>
        <g>
          <animateTransform attributeName="transform" type="rotate" from="360" to="0" dur="24s" repeatCount="indefinite" />
          <circle cx="0" cy="-30" r="2.6" fill="#C58B2A" />
        </g>
        <g>
          <animateTransform attributeName="transform" type="rotate" from="80" to="440" dur="36s" repeatCount="indefinite" />
          <circle cx="0" cy="-46" r="2.2" fill="#071F46" fill-opacity="0.4" />
        </g>
        <g>
          <animateTransform attributeName="transform" type="rotate" from="200" to="-160" dur="48s" repeatCount="indefinite" />
          <circle cx="0" cy="-62" r="2.4" fill="#C58B2A" fill-opacity="0.75" />
        </g>
      </g>
      <path
        d="M132 86 C 210 78, 250 42, 318 48"
        stroke="#071F46"
        stroke-opacity="0.4"
        stroke-dasharray="1.6 5"
      >
        <animate attributeName="stroke-dashoffset" from="0" to="-40" dur="8s" repeatCount="indefinite" />
      </path>
      <circle r="3.1" fill="#C58B2A">
        <animateMotion dur="8s" repeatCount="indefinite" keyPoints="0;1;0" keyTimes="0;0.55;1" calcMode="linear" path="M132 86 C 210 78, 250 42, 318 48" />
      </circle>
      <g>
        <animateTransform
          attributeName="transform"
          type="translate"
          values="0 0; 3 -3; -2 2; 0 0"
          dur="18s"
          repeatCount="indefinite"
        />
        <path d="M318 48 L292 92 L344 78 L360 118" stroke="#071F46" stroke-opacity="0.18" />
        <circle cx="318" cy="48" r="4.5" fill="#071F46" fill-opacity="0.55" />
        <circle cx="292" cy="92" r="3.2" fill="#071F46" fill-opacity="0.28" />
        <circle cx="344" cy="78" r="3" fill="#C58B2A" fill-opacity="0.55" />
        <circle cx="360" cy="118" r="2.6" fill="#071F46" fill-opacity="0.22" />
      </g>
    </svg>
  )
}

{
  kind === 'dynamics' && (
    <svg class:list={['research-illustration', className]} viewBox="0 0 400 168" fill="none" aria-hidden="true">
      <rect width="400" height="168" fill="#F7F5EF" />
      <g>
        <animateTransform
          attributeName="transform"
          type="translate"
          values="0 0; 2 -3; -2 2; 0 0"
          dur="22s"
          repeatCount="indefinite"
        />
        <g stroke="#071F46" stroke-opacity="0.2" stroke-width="1">
          <path d="M72 118 L128 64 L196 92" />
          <path d="M128 64 L176 40 L254 58" />
          <path d="M196 92 L254 58 L318 86" />
          <path d="M196 92 L168 140 L254 128" />
          <path d="M254 58 L300 28" />
          <path d="M318 86 L344 132" />
        </g>
        <circle cx="72" cy="118" r="4" fill="#071F46" fill-opacity="0.35" />
        <circle cx="128" cy="64" r="3.5" fill="#071F46" fill-opacity="0.28" />
        <circle cx="176" cy="40" r="3.2" fill="#8A93A3" />
        <circle cx="168" cy="140" r="3" fill="#8A93A3" />
        <circle cx="254" cy="128" r="3.2" fill="#071F46" fill-opacity="0.25" />
        <circle cx="300" cy="28" r="3" fill="#C58B2A" fill-opacity="0.7" />
        <circle cx="318" cy="86" r="3.5" fill="#071F46" fill-opacity="0.3" />
        <circle cx="344" cy="132" r="2.8" fill="#8A93A3" />
        <circle cx="254" cy="58" r="3.8" fill="#C58B2A" fill-opacity="0.55" />
        <g transform="translate(196 92)">
          <circle r="16" stroke="#C58B2A" stroke-opacity="0.85" fill="none" />
          <circle r="4.5" fill="#071F46" />
          <g>
            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="14s" repeatCount="indefinite" />
            <circle cx="0" cy="-16" r="2.3" fill="#C58B2A" />
          </g>
        </g>
      </g>
    </svg>
  )
}

{
  kind === 'hero' && (
    <svg class:list={['research-illustration', 'hero-illustration', className]} viewBox="0 0 560 460" fill="none" aria-hidden="true">
      <g transform="translate(168 168)">
        <circle r="150" stroke="#C58B2A" stroke-opacity="0.28" />
        <circle r="118" stroke="#071F46" stroke-opacity="0.1" />
        <circle r="86" stroke="#C58B2A" stroke-opacity="0.32" />
        <circle r="54" stroke="#071F46" stroke-opacity="0.14" />
        <circle r="26" stroke="#071F46" stroke-opacity="0.2" />
        <circle r="5" fill="#071F46" />

        <g>
          <animateTransform attributeName="transform" type="rotate" from="40" to="400" dur="14s" repeatCount="indefinite" />
          <circle cx="0" cy="-26" r="2.3" fill="#071F46" fill-opacity="0.45" />
        </g>
        <g>
          <animateTransform attributeName="transform" type="rotate" from="360" to="0" dur="22s" repeatCount="indefinite" />
          <circle cx="0" cy="-54" r="2.8" fill="#C58B2A" />
        </g>
        <g>
          <animateTransform attributeName="transform" type="rotate" from="110" to="470" dur="32s" repeatCount="indefinite" />
          <circle cx="0" cy="-86" r="3.1" fill="#C58B2A" />
        </g>
        <g>
          <animateTransform attributeName="transform" type="rotate" from="0" to="-360" dur="46s" repeatCount="indefinite" />
          <circle cx="0" cy="-118" r="2.6" fill="#071F46" fill-opacity="0.35" />
        </g>
        <g>
          <animateTransform attributeName="transform" type="rotate" from="200" to="560" dur="58s" repeatCount="indefinite" />
          <circle cx="0" cy="-150" r="3" fill="#C58B2A" fill-opacity="0.8" />
        </g>
      </g>

      <path
        d="M210 168 C 330 150, 390 96, 430 168"
        stroke="#071F46"
        stroke-opacity="0.38"
        stroke-dasharray="1.8 6"
      >
        <animate attributeName="stroke-dashoffset" from="0" to="-48" dur="9s" repeatCount="indefinite" />
      </path>
      <circle r="3.4" fill="#C58B2A">
        <animateMotion
          dur="10s"
          repeatCount="indefinite"
          keyPoints="0;1;0"
          keyTimes="0;0.55;1"
          calcMode="linear"
          path="M210 168 C 330 150, 390 96, 430 168"
        />
      </circle>

      <g>
        <animateTransform
          attributeName="transform"
          type="translate"
          values="0 0; 4 -3; -2 3; 0 0"
          dur="20s"
          repeatCount="indefinite"
        />
        <g stroke="#071F46" stroke-opacity="0.18">
          <path d="M490 108 L430 168 L520 190" />
          <path d="M430 168 L454 248" />
          <path d="M520 190 L548 150" />
          <path d="M454 248 L510 270" />
        </g>
        <circle cx="430" cy="168" r="4.2" fill="#071F46" fill-opacity="0.45" />
        <circle cx="490" cy="108" r="5" fill="#C58B2A" />
        <circle cx="520" cy="190" r="4" fill="#071F46" fill-opacity="0.3" />
        <circle cx="548" cy="150" r="3.2" fill="#8A93A3" />
        <circle cx="454" cy="248" r="3.6" fill="#C58B2A" fill-opacity="0.55" />
        <circle cx="510" cy="270" r="3" fill="#071F46" fill-opacity="0.22" />
      </g>
    </svg>
  )
}

<script>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document
      .querySelectorAll('.research-illustration animate, .research-illustration animateTransform, .research-illustration animateMotion')
      .forEach((el) => el.remove());
  }
</script>

<style>
  .research-illustration {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hero-illustration {
    width: 100%;
    height: auto;
    mask-image: linear-gradient(105deg, #000 58%, transparent 96%);
  }
</style>
