---
interface Props {
  href: string;
  title: string;
  description: string;
  illustration: 'surprise' | 'positioning' | 'dynamics';
  icon: 'chart' | 'target' | 'nodes';
}

import ResearchIllustration from './ResearchIllustration.astro';
import Icon from './Icon.astro';

const { href, title, description, illustration, icon } = Astro.props;
---

<a class="research-card" href={href}>
  <div class="visual">
    <ResearchIllustration kind={illustration} />
    <span class="badge">
      <Icon name={icon} size={18} />
    </span>
  </div>
  <div class="body">
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="card-arrow" aria-hidden="true">
      <Icon name="arrow" size={16} />
    </span>
  </div>
</a>

<style>
  .research-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: inherit;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: transform var(--ease), box-shadow var(--ease), border-color var(--ease);
  }

  .research-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-hover);
  }

  .visual {
    position: relative;
    height: 148px;
  }

  .badge {
    position: absolute;
    left: 1.1rem;
    bottom: -18px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    background: var(--white);
    color: var(--gold);
  }

  .body {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 2rem 1.25rem 1.2rem;
  }

  h3 {
    margin: 0 0 0.55rem;
    font-size: 1.45rem;
    font-weight: 500;
  }

  p {
    margin: 0;
    padding-right: 1.4rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .card-arrow {
    align-self: flex-end;
    margin-top: 1.1rem;
    color: var(--gold);
    transition: transform var(--ease);
  }

  .research-card:hover .card-arrow {
    transform: translateX(4px);
  }
</style>
