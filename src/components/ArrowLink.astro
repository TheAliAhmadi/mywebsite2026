---
import Icon from './Icon.astro';

interface Props {
  href: string;
  external?: boolean;
}

const { href, external = false } = Astro.props;
---

<a
  class="arrow-link"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
  <Icon name={external ? 'external' : 'arrow'} size={16} />
</a>
