---
import { SITE, SOCIAL_LINKS } from '../data/content';

const year = new Date().getFullYear();
---

<footer>
  <div class="container footer-inner">
    <div>
      <p class="footer-label">Office</p>
      <p>{SITE.location}</p>
    </div>
    <div>
      <p class="footer-label">Email</p>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
    <div class="social">
      <p class="footer-label">Elsewhere</p>
      <div class="social-links">
        <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={SOCIAL_LINKS.x} target="_blank" rel="noopener noreferrer">X</a>
        <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
      </div>
    </div>
  </div>
  <div class="copyright">
    <div class="container">
      <p>© {year} {SITE.title}</p>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2rem;
    padding: 2.5rem 0 1.75rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .footer-label {
    margin: 0 0 0.35rem;
    color: var(--gold);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-inner a {
    color: var(--navy);
  }

  .footer-inner a:hover {
    color: var(--gold-deep);
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .copyright {
    padding: 0.9rem 0 1.4rem;
    color: var(--text-soft);
    font-size: 0.82rem;
  }

  .copyright p {
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 1.4rem;
      padding-top: 2rem;
    }
  }
</style>
