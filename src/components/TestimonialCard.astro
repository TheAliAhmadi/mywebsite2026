---
interface Props {
  quote: string;
  attribution: string;
  meta: string;
}

const { quote, attribution, meta } = Astro.props;
---

<blockquote class="testimonial-card">
  <span class="quote-mark" aria-hidden="true">“</span>
  <p>{quote}</p>
  <footer>
    <cite>{attribution}</cite>
    <span>{meta}</span>
  </footer>
</blockquote>

<style>
  .testimonial-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding: 1.5rem 1.4rem 1.3rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .quote-mark {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--gold);
    font-family: var(--font-serif);
    font-size: 2.4rem;
    line-height: 1;
  }

  p {
    margin: 0 0 1.2rem;
    color: var(--text);
    font-size: 0.96rem;
    line-height: 1.65;
  }

  footer {
    margin-top: auto;
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  cite {
    display: block;
    color: var(--navy);
    font-style: normal;
    font-weight: 600;
  }
</style>
