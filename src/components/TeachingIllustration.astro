---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['teaching-illustration', className]}
  viewBox="0 0 560 460"
  fill="none"
  aria-hidden="true"
>
  <!-- Quiet residual marks, so the sequence does not read as a flowchart. -->
  <g stroke="#071F46" stroke-opacity="0.08" stroke-linecap="round">
    <path d="M72 108 C 108 90, 142 96, 164 114" />
    <path d="M78 338 C 118 354, 158 348, 184 330" />
    <path d="M318 78 C 352 62, 386 68, 410 90" />
  </g>

  <!-- Discussion: viewpoints gather around one shared case. -->
  <g class="discussion" transform="translate(168 228)">
    <g>
      <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="56s" repeatCount="indefinite" />

      <g stroke="#071F46" stroke-width="1" stroke-linecap="round" stroke-opacity="0.18">
        <path d="M0 -86 C -2 -56, -3 -32, 0 -16" />
        <path d="M78 -44 C 52 -30, 30 -18, 12 -8" />
        <path d="M96 36 C 62 24, 36 12, 14 6" />
        <path d="M18 84 C 12 56, 8 32, 4 16" />
        <path d="M-74 54 C -48 36, -28 20, -12 8" />
        <path d="M-98 -26 C -62 -20, -34 -14, -14 -6" />
      </g>

      <circle cx="0" cy="-86" r="4.1" fill="#071F46" fill-opacity="0.42" />
      <circle cx="78" cy="-44" r="3.3" fill="#8A93A3" />
      <circle cx="96" cy="36" r="3.9" fill="#071F46" fill-opacity="0.30" />
      <circle cx="18" cy="84" r="3.5" fill="#C58B2A" fill-opacity="0.74" />
      <circle cx="-74" cy="54" r="4" fill="#071F46" fill-opacity="0.38" />
      <circle cx="-98" cy="-26" r="3.4" fill="#8A93A3" />
    </g>

    <g transform="rotate(-6)">
      <rect x="-23" y="-17" width="46" height="34" rx="2" fill="#FCFBF8" stroke="#071F46" stroke-opacity="0.46" />
      <path d="M-14 -7 H12 M-14 0 H7 M-14 7 H14" stroke="#071F46" stroke-opacity="0.30" stroke-linecap="round" />
      <circle cx="18" cy="-12" r="3" fill="#C58B2A" />
    </g>

    <circle r="32" stroke="#C58B2A" fill="none" stroke-opacity="0">
      <animate attributeName="r" values="26;40;26" dur="7s" repeatCount="indefinite" />
      <animate attributeName="stroke-opacity" values="0;0.20;0" dur="7s" repeatCount="indefinite" />
    </circle>
  </g>

  <!-- Interpretation: discussion leaves the case and moves toward judgment. -->
  <path
    d="M192 228 C 258 224, 304 204, 346 196"
    stroke="#071F46"
    stroke-opacity="0.34"
    stroke-dasharray="1.8 6"
    stroke-linecap="round"
  >
    <animate attributeName="stroke-dashoffset" from="0" to="-48" dur="9s" repeatCount="indefinite" />
  </path>

  <!-- Judgment: three alternatives; one recommendation is taken. -->
  <g class="decision-tree">
    <path d="M346 196 C 384 180, 408 148, 438 126" stroke="#071F46" stroke-opacity="0.16" />
    <path d="M346 196 C 388 200, 422 216, 458 224" stroke="#C58B2A" stroke-opacity="0.78" stroke-width="1.3" />
    <path d="M346 196 C 380 224, 394 266, 420 306" stroke="#071F46" stroke-opacity="0.16" />

    <circle cx="346" cy="196" r="4.3" fill="#071F46" fill-opacity="0.48" />
    <circle cx="438" cy="126" r="3.3" fill="#071F46" fill-opacity="0.22" />
    <circle cx="458" cy="224" r="5.1" fill="#C58B2A" />
    <circle cx="420" cy="306" r="3.3" fill="#071F46" fill-opacity="0.22" />

    <g stroke="#071F46" stroke-opacity="0.14">
      <path d="M458 224 L490 200" />
      <path d="M458 224 L494 248" />
    </g>
    <circle cx="490" cy="200" r="2.6" fill="#8A93A3" />
    <circle cx="494" cy="248" r="2.6" fill="#071F46" fill-opacity="0.22" />
  </g>

  <!-- The student's path: case → discussion → judgment → recommendation. -->
  <circle r="3.4" fill="#C58B2A">
    <animateMotion
      dur="11s"
      repeatCount="indefinite"
      keyPoints="0;0.62;0.62;1"
      keyTimes="0;0.46;0.58;1"
      calcMode="linear"
      path="M168 228 C 240 226, 300 208, 346 196 C 388 200, 422 216, 458 224"
    />
  </circle>
</svg>

<script>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document
      .querySelectorAll(
        '.teaching-illustration animate, .teaching-illustration animateTransform, .teaching-illustration animateMotion'
      )
      .forEach((el) => el.remove());
  }
</script>

<style>
  .teaching-illustration {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    mask-image: linear-gradient(105deg, #000 74%, transparent 100%);
  }
</style>
